{
  "name": "@interloper/ui",
  "version": "0.141.0",
  "description": "Build an interloper extension's UI against the app: a Vite preset, Tailwind against the app's theme, and the app's types.",
  "license": "Apache-2.0",
  "homepage": "https://docs.interloper.dev/extending/extensions/#building-it-with-the-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitl-cloud/interloper.git",
    "directory": "packages/platform/interloper-app/sdk"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "src/tailwind.css",
    "tsconfig.extension.json"
  ],
  "exports": {
    "./vite": "./src/vite.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./tsconfig": "./tsconfig.extension.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./tailwind.css": "./src/tailwind.css",
      "./tsconfig": "./tsconfig.extension.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc -p tsconfig.build.json",
    "check:package": "node scripts/check-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.4",
    "@nuxt/ui": "~4.12.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "3.3.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "3.3.11"
  }
}

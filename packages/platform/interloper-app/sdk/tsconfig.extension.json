{
  // What an extension's UI type-checks with: `"extends": "@interloper/ui/tsconfig"`.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "types": ["vite/client"],
    "paths": {
      "@interloper/host": ["./dist/host/app/extensions/shared/host.d.ts"],
      "#build/ui": ["./dist/ui/index.ts"],
      "#build/ui/*": ["./dist/ui/*"]
    }
  },
  "files": ["./dist/host/components.d.ts"]
}

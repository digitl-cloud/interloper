{
  "uid": "interloper-overview",
  "title": "Interloper — Runs & Assets",
  "tags": ["interloper"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(interloper_runs_total, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Runs in range",
      "description": "Counters come from a short-lived process; widen the time range or re-run the pipeline if this reads zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(interloper_runs_total{job=~\"$service\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Run success rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(interloper_runs_total{job=~\"$service\",status=\"completed\"}[$__range])) / clamp_min(sum(increase(interloper_runs_total{job=~\"$service\"}[$__range])), 1)",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runs by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 0 },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "completed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(interloper_runs_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Run duration",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(interloper_run_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(interloper_run_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "type": "row",
      "title": "Assets",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Asset executions by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 0 },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "canceled" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "completed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(interloper_assets_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Asset duration p95 by asset",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, asset_key) (rate(interloper_asset_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{asset_key}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Asset outcomes",
      "description": "Which assets fail, and how often, over the dashboard time range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "decimals": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "gradient" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "asset_key", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true },
            "renameByName": {
              "Value #A": "completed",
              "Value #B": "failed",
              "Value #C": "canceled"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (asset_key) (increase(interloper_assets_total{job=~\"$service\",status=\"completed\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (asset_key) (increase(interloper_assets_total{job=~\"$service\",status=\"failed\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (asset_key) (increase(interloper_assets_total{job=~\"$service\",status=\"canceled\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Destination I/O",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" }, "lineWidth": 0 },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, status, destination_key) (increase(interloper_destination_io_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{destination_key}} {{operation}} ({{status}})"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traces",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "type": "table",
      "title": "Recent runs — click a trace to open the span tree",
      "description": "Every row is one interloper.runner.run span. Errored runs are the ones worth opening.",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"interloper.runner.run\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ]
}

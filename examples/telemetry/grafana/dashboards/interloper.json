{
  "uid": "interloper-overview",
  "title": "Interloper \u2014 Runs & Assets",
  "tags": [
    "interloper"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(interloper_runs_total, job)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Runs in range",
      "description": "Runs completed in the dashboard time range. An exact counter delta rather than increase(), which extrapolates and would render 10 runs as 11.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(interloper_runs_total{job=~\"$service\"}) or vector(0)) - (sum(interloper_runs_total{job=~\"$service\"} offset $__range) or vector(0))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Run success rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(interloper_runs_total{job=~\"$service\",status=\"completed\"}) or vector(0)) - (sum(interloper_runs_total{job=~\"$service\",status=\"completed\"} offset $__range) or vector(0))) / clamp_min((sum(interloper_runs_total{job=~\"$service\"}) or vector(0)) - (sum(interloper_runs_total{job=~\"$service\"} offset $__range) or vector(0)), 1)",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Runs by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(interloper_runs_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Activity per interval, not a count: rate-shaped panels extrapolate to the window edges, so bar heights are approximate. The stat and table panels above carry the exact counts."
    },
    {
      "type": "timeseries",
      "title": "Run duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(interloper_run_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(interloper_run_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ],
      "description": "Quantiles over histogram buckets \u2014 with few observations the value lands wherever the containing bucket interpolates; it converges as runs accumulate."
    },
    {
      "type": "row",
      "title": "Assets",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Asset executions by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "canceled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "completed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(interloper_assets_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Activity per interval, not a count: rate-shaped panels extrapolate to the window edges, so bar heights are approximate. The stat and table panels above carry the exact counts."
    },
    {
      "type": "timeseries",
      "title": "Asset duration p95 by asset",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, asset_key) (rate(interloper_asset_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{asset_key}}"
        }
      ],
      "description": "Quantiles over histogram buckets \u2014 with few observations the value lands wherever the containing bucket interpolates; it converges as runs accumulate."
    },
    {
      "type": "table",
      "title": "Asset outcomes",
      "description": "Which assets fail, and how often, over the dashboard time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "asset_key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "completed",
              "Value #B": "failed",
              "Value #C": "canceled"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"completed\"}) - (sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"completed\"} offset $__range) or sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"completed\"}) * 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"failed\"}) - (sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"failed\"} offset $__range) or sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"failed\"}) * 0)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"canceled\"}) - (sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"canceled\"} offset $__range) or sum by (asset_key) (interloper_assets_total{job=~\"$service\",status=\"canceled\"}) * 0)",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Destination I/O",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 0
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, status, destination_key) (increase(interloper_destination_io_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{destination_key}} {{operation}} ({{status}})"
        }
      ],
      "description": "Activity per interval, not a count: rate-shaped panels extrapolate to the window edges, so bar heights are approximate. The stat and table panels above carry the exact counts."
    },
    {
      "type": "row",
      "title": "Traces",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      }
    },
    {
      "type": "table",
      "title": "Recent runs \u2014 click a trace to open the span tree",
      "description": "Every row is one interloper.runner.run span. Errored runs are the ones worth opening.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ name = \"interloper.runner.run\" }",
          "limit": 50,
          "tableType": "traces"
        }
      ]
    }
  ]
}
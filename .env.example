# Local dev config for the harness. Copy to `.env` (gitignored) and fill in:
#
#   cp .env.example .env
#
# `.env` is loaded by the Makefile for the host path (`make dev*`) and by the
# compose stack (`make compose-*`, via env_file). Use plain KEY=value lines (no
# quotes). Set only what you need — everything here is optional or has a default.

# ── Infra overrides ───────────────────────────────────────────────-----------
# The harness already sets Postgres + a throwaway encryption key for `make dev`
# and `make compose-*` (and compose's `environment:` overrides these for its
# containers). Set them here only when running the `interloper` CLI directly,
# outside the harness.
# INTERLOPER_ENCRYPTION_KEY=dev-encryption-key-not-for-production
# INTERLOPER_POSTGRES_HOST=localhost
# INTERLOPER_POSTGRES_PORT=5432
# INTERLOPER_POSTGRES_USER=postgres
# INTERLOPER_POSTGRES_PASSWORD=postgres
# INTERLOPER_POSTGRES_DATABASE=interloper
# SMTP (email invites): host/user/from come from interloper.yaml; password here.
# INTERLOPER_SMTP_PASSWORD=


# ── Dev super-admin ──────────────────────────────────────────────────────────
# The seed grants super-admin + "Dev Org" to the profile holding this address;
# your first login with it, through any provider, joins that profile.
INTERLOPER_DEV_USER_EMAIL=you@example.com


# ── App login: Google and Microsoft ──────────────────────────────────────────
# Configure at least one provider, or the login page offers no way to sign in.
#
# Google: create an OAuth 2.0 Client (type: Web application) in Google Cloud and
# add http://localhost:3000/api/auth/google/callback (<INTERLOPER_SERVER_EXTERNAL_URL>
# /api/auth/google/callback) to its "Authorized redirect URIs".
INTERLOPER_AUTH_GOOGLE_CLIENT_ID=
INTERLOPER_AUTH_GOOGLE_CLIENT_SECRET=
# Microsoft (work and school accounts): register a multi-tenant app in Microsoft
# Entra with the Web redirect URI http://localhost:3000/api/auth/microsoft/callback
# and the optional ID token claims `email` and `xms_edov`; logins without a
# domain-verified address are refused.
INTERLOPER_AUTH_MICROSOFT_CLIENT_ID=
INTERLOPER_AUTH_MICROSOFT_CLIENT_SECRET=
# The default below suits local http.
# INTERLOPER_AUTH_COOKIE_SECURE=false
# Comma-separated emails promoted to super-admin when the API starts and on login (promote-only).
# The seed above already covers dev; this is the production bootstrap path.
# INTERLOPER_AUTH_SUPER_ADMIN_EMAILS=
# Comma-separated email domains allowed to sign up (first login). Empty keeps
# signup open. Existing profiles, super-admins and invited emails always pass.
# INTERLOPER_AUTH_ALLOWED_DOMAINS=


# ── Connector OAuth (connecting data sources from the UI) ────────────────────
# Read at the API route level from these provider-scoped vars (one set per
# provider: INTERLOPER_<PROVIDER>_CLIENT_ID / _CLIENT_SECRET). A provider shows
# up as connectable once both are set. Its redirect URI is the app's
# <INTERLOPER_SERVER_EXTERNAL_URL>/auth/<provider> page (register that in the
# provider console); INTERLOPER_<PROVIDER>_REDIRECT_URI overrides it. SCOPE / *_TOKEN /
# CONFIG_ID are provider-specific extras used when building the authorize URL.
# Set only the providers you actually want to connect.

INTERLOPER_GOOGLE_CLIENT_ID=
INTERLOPER_GOOGLE_CLIENT_SECRET=

INTERLOPER_AMAZON_CLIENT_ID=
INTERLOPER_AMAZON_CLIENT_SECRET=
AMAZON_SCOPE=

INTERLOPER_MICROSOFT_CLIENT_ID=
INTERLOPER_MICROSOFT_CLIENT_SECRET=
MICROSOFT_DEVELOPER_TOKEN=
MICROSOFT_SCOPE=

INTERLOPER_CRITEO_CLIENT_ID=
INTERLOPER_CRITEO_CLIENT_SECRET=

INTERLOPER_FACEBOOK_CLIENT_ID=
INTERLOPER_FACEBOOK_CLIENT_SECRET=
FACEBOOK_SCOPE=
FACEBOOK_CONFIG_ID=

INTERLOPER_LINKEDIN_CLIENT_ID=
INTERLOPER_LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPE=

INTERLOPER_PINTEREST_CLIENT_ID=
INTERLOPER_PINTEREST_CLIENT_SECRET=
PINTEREST_SCOPE=

INTERLOPER_SNAPCHAT_CLIENT_ID=
INTERLOPER_SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_SCOPE=

INTERLOPER_TIKTOK_CLIENT_ID=
INTERLOPER_TIKTOK_CLIENT_SECRET=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
